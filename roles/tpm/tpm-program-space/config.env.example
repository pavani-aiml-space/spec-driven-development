# Confluence config for the tpm-program-space skill.
# Copy this to config.env and fill in your real values.
# config.env is git-ignored (see .gitignore) - kept local, never committed.
#
# CONFLUENCE_API_TOKEN is NOT set here. It's personal (tied to your
# Atlassian account) and must stay in your own shell profile (~/.zshrc),
# never in this file. Create one at:
# https://id.atlassian.com/manage-profile/security/api-tokens
#
# The `:=` form only fills in a variable if it isn't already set, so a
# personal override in your shell always wins over this file.

: "${CONFLUENCE_SITE:=your-site.atlassian.net}"
: "${CONFLUENCE_EMAIL:=you@example.com}"
: "${CONFLUENCE_SPACE_KEY:=YOURKEY}"
